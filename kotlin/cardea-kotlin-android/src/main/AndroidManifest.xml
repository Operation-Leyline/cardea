<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
          Opens the Custom Tab and returns the outcome to the app. The activity that
          receives the redirect, CardeaRedirectActivity, is for the app to declare,
          with the addresses it owns: see kotlin/README.md.
        -->
        <activity
            android:name="com.operationleyline.cardea.android.CardeaBrowserActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
